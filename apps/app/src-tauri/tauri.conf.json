{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "veyrimi",
  "version": "0.1.0",
  "identifier": "com.changzai.stillhere",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "veyrimi · 如晤",
        "width": 1280,
        "height": 800,
        "minWidth": 1024,
        "minHeight": 700,
        "center": true,
        "resizable": true,
        "visible": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "resources": {
      "resources/libcrypto-3-x64.dll": "libcrypto-3-x64.dll",
      "resources/libssl-3-x64.dll": "libssl-3-x64.dll",
      "resources/OPENSSL-NOTICE.txt": "OPENSSL-NOTICE.txt"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      }
    }
  }
}
